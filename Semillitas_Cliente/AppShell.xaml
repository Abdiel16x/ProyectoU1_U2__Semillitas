<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Semillitas_Cliente.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Semillitas_Cliente"
    xmlns:views="clr-namespace:Semillitas_Cliente.Views"
    Title="Semillitas_Cliente">

    <ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate views:InicioView}"
        Route="Inicio" />

    <ShellContent
        Title="Inscripciones"
        ContentTemplate="{DataTemplate views:InscripcionesView}"
        Route="Inscripciones" />

    <ShellContent
        Title="Alumnos"
        ContentTemplate="{DataTemplate views:AlumnosView}"
        Route="Alumnos" />

    <ShellContent
        Title="Pagos"
        ContentTemplate="{DataTemplate views:PagosView}"
        Route="Pagos" />

    <ShellContent
        Title="Reportes"
        ContentTemplate="{DataTemplate views:ReportesView}"
        Route="Reportes" />

    <ShellContent
        Title="Talleres"
        ContentTemplate="{DataTemplate views:TalleresView}"
        Route="Talleres" />

    <ShellContent
        Title="Tutores"
        ContentTemplate="{DataTemplate views:TutoresView}"
        Route="Tutores" />
</Shell>
