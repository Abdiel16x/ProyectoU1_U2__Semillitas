<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Semillitas_Cliente.Views.AgregarTallerView"
    Title="Agregar taller"
    BackgroundColor="#EEE5C2">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="5">
                <Label
                    Text="Nuevo taller"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#1B475D" />

                <Label
                    Text="Registra un nuevo taller para Semillitas."
                    FontSize="14"
                    TextColor="#1B475D" />
            </VerticalStackLayout>

            <!-- Formulario -->
            <Border
                BackgroundColor="White"
                Stroke="#8EBD9D"
                StrokeShape="RoundRectangle 12"
                Padding="20">

                <VerticalStackLayout Spacing="16">

                    <!-- Nombre -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Nombre del taller"
                            FontAttributes="Bold"
                            TextColor="#1B475D" />

                        <Entry
                            Placeholder="Nombre del taller"
                            Text="{Binding Nombre}"
                            TextColor="Black"
                            PlaceholderColor="#777777" />
                    </VerticalStackLayout>

                    <!-- Instructor -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Instructor"
                            FontAttributes="Bold"
                            TextColor="#1B475D" />

                        <Picker
                            Title="Seleccionar instructor"
                            ItemsSource="{Binding Instructores}"
                            ItemDisplayBinding="{Binding Nombre}"
                            SelectedItem="{Binding InstructorSeleccionado}"
                            TextColor="Black"
                            TitleColor="#777777" />
                    </VerticalStackLayout>

                    <!-- Categoría -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Categoría"
                            FontAttributes="Bold"
                            TextColor="#1B475D" />

                        <Picker
                            Title="Seleccionar categoría"
                            ItemsSource="{Binding Categorias}"
                            ItemDisplayBinding="{Binding Nombre}"
                            SelectedItem="{Binding CategoriaSeleccionada}"
                            TextColor="Black"
                            TitleColor="#777777" />
                    </VerticalStackLayout>

                    <!-- Cupo máximo -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Cupo máximo"
                            FontAttributes="Bold"
                            TextColor="#1B475D" />

                        <Entry
                            Placeholder="Número de alumnos"
                            Text="{Binding CupoMaximo}"
                            Keyboard="Numeric"
                            TextColor="Black"
                            PlaceholderColor="#777777" />
                    </VerticalStackLayout>

                    <!-- Costo mensual -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Costo mensual"
                            FontAttributes="Bold"
                            TextColor="#1B475D" />

                        <Entry
                            Placeholder="Ej. 500.00"
                            Text="{Binding CostoMensual}"
                            Keyboard="Numeric"
                            TextColor="Black"
                            PlaceholderColor="#777777" />
                    </VerticalStackLayout>

                    <!-- Horarios -->
                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="Horarios del taller"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#1B475D" />

                        <Label
                            Text="Selecciona el día y las horas de cada sesión."
                            FontSize="13"
                            TextColor="#1B475D" />

                        <!-- Día -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Día"
                                FontAttributes="Bold"
                                TextColor="#1B475D" />

                            <Picker
                                Title="Seleccionar día"
                                ItemsSource="{Binding DiasSemana}"
                                SelectedItem="{Binding DiaSeleccionado}"
                                TextColor="Black"
                                TitleColor="#777777" />
                        </VerticalStackLayout>

                        <!-- Hora de inicio -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Hora de inicio"
                                FontAttributes="Bold"
                                TextColor="#1B475D" />

                            <TimePicker
                                Time="{Binding HoraInicio}"
                                Format="HH:mm"
                                TextColor="Black" />
                        </VerticalStackLayout>

                        <!-- Hora de fin -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Hora de fin"
                                FontAttributes="Bold"
                                TextColor="#1B475D" />

                            <TimePicker
                                Time="{Binding HoraFin}"
                                Format="HH:mm"
                                TextColor="Black" />
                        </VerticalStackLayout>

                        <!-- Agregar horario -->
                        <Button
                            Text="+ Agregar horario"
                            Command="{Binding AgregarHorarioCommand}"
                            BackgroundColor="#8EBD9D"
                            TextColor="#1B475D"
                            CornerRadius="10"
                            Padding="15,12" />

                        <!-- Horarios agregados -->
                        <Label
                            Text="Horarios agregados"
                            FontAttributes="Bold"
                            TextColor="#1B475D" />

                        <CollectionView
                            ItemsSource="{Binding HorariosAgregados}"
                            SelectionMode="None">

                            <CollectionView.EmptyView>
                                <Label
                                    Text="Aún no has agregado horarios."
                                    FontSize="13"
                                    TextColor="#777777"
                                    Padding="8" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        BackgroundColor="#F5F5F0"
                                        Stroke="#8EBD9D"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="12"
                                        Margin="0,0,0,8">

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            RowDefinitions="Auto,Auto"
                                            ColumnSpacing="10"
                                            RowSpacing="5">

                                            <Label
                                                Text="{Binding DiaNombre}"
                                                FontAttributes="Bold"
                                                TextColor="#1B475D"
                                                Grid.Row="0"
                                                Grid.Column="0" />

                                            <Label
                                                Text="{Binding HoraInicio}"
                                                TextColor="#1B475D"
                                                Grid.Row="1"
                                                Grid.Column="0" />

                                            <Label
                                                Text="{Binding HoraFin}"
                                                TextColor="#1B475D"
                                                Grid.Row="1"
                                                Grid.Column="1" />

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Mensaje -->
                    <Label
                        Text="{Binding Mensaje}"
                        FontSize="13"
                        TextColor="#1B475D" />

                    <!-- Acciones -->
                    <Button
                        Text="Guardar taller"
                        Command="{Binding GuardarCommand}"
                        BackgroundColor="#1B475D"
                        TextColor="White"
                        CornerRadius="10"
                        Padding="15,12" />

                    <Button
                        Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        BackgroundColor="#FAD564"
                        TextColor="#1B475D"
                        CornerRadius="10"
                        Padding="15,12" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
