<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Semillitas_Cliente.Views.ReportesView"
    Title="Reportes"
    BackgroundColor="#EEE5C2">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="22">

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Reportes"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#1B475D" />

                <Label
                    Text="Consulta los reportes de talleres, inscripciones e ingresos."
                    FontSize="14"
                    TextColor="#000000" />
            </VerticalStackLayout>

            <!-- Inscritos por taller -->
            <VerticalStackLayout Spacing="12">
                <Label
                    Text="Inscritos por taller"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#1B475D" />

                <Border
                    BackgroundColor="White"
                    Stroke="#8EBD9D"
                    StrokeThickness="1"
                    Padding="12">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <CollectionView
                        ItemsSource="{Binding InscritosPorTaller}"
                        SelectionMode="None">

                        <CollectionView.EmptyView>
                            <Label
                                Text="No hay información de inscripciones."
                                Padding="12"
                                TextColor="#000000"
                                HorizontalTextAlignment="Center" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout
                                    Spacing="8"
                                    Padding="4,12">

                                    <Label
                                        Text="{Binding NombreTaller}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="#1B475D" />

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="12">

                                        <VerticalStackLayout Spacing="4">
                                            <Label
                                                Text="Cupo máximo"
                                                FontSize="12"
                                                TextColor="#1B475D" />

                                            <Label
                                                Text="{Binding CupoMaximo}"
                                                FontSize="15"
                                                TextColor="#000000" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="4">

                                            <Label
                                                Text="Inscritos actuales"
                                                FontSize="12"
                                                TextColor="#1B475D" />

                                            <Label
                                                Text="{Binding InscritosActuales}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="#1B475D" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Label
                                        Text="{Binding Disponibles, StringFormat='Lugares disponibles: {0}'}"
                                        FontSize="14"
                                        TextColor="#1B475D" />

                                    <BoxView
                                        HeightRequest="1"
                                        Color="#D3DC7C" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

            <!-- Ingresos por período -->
            <VerticalStackLayout Spacing="12">
                <Label
                    Text="Ingresos por período"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#1B475D" />

                <Border
                    BackgroundColor="White"
                    Stroke="#8EBD9D"
                    StrokeThickness="1"
                    Padding="12">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <CollectionView
                        ItemsSource="{Binding IngresosPorPeriodo}"
                        SelectionMode="None">

                        <CollectionView.EmptyView>
                            <Label
                                Text="No hay información de ingresos."
                                Padding="12"
                                TextColor="#000000"
                                HorizontalTextAlignment="Center" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout
                                    Spacing="8"
                                    Padding="4,12">

                                    <Label
                                        Text="{Binding NombrePeriodo}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="#1B475D" />

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="12">

                                        <VerticalStackLayout Spacing="4">
                                            <Label
                                                Text="Ingresos cobrados"
                                                FontSize="12"
                                                TextColor="#1B475D" />

                                            <Label
                                                Text="{Binding IngresosCobrados, StringFormat='{0:C}'}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="#1B475D" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="4">

                                            <Label
                                                Text="Por cobrar"
                                                FontSize="12"
                                                TextColor="#1B475D" />

                                            <Label
                                                Text="{Binding PorCobrar, StringFormat='{0:C}'}"
                                                FontSize="15"
                                                TextColor="#000000" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <BoxView
                                        HeightRequest="1"
                                        Color="#D3DC7C" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

            <!-- Ranking de talleres -->
            <VerticalStackLayout Spacing="12">
                <Label
                    Text="Ranking de talleres"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#1B475D" />

                <Border
                    BackgroundColor="White"
                    Stroke="#8EBD9D"
                    StrokeThickness="1"
                    Padding="12">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <CollectionView
                        ItemsSource="{Binding RankingTalleres}"
                        SelectionMode="None">

                        <CollectionView.EmptyView>
                            <Label
                                Text="No hay información para el ranking."
                                Padding="12"
                                TextColor="#000000"
                                HorizontalTextAlignment="Center" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout
                                    Spacing="8"
                                    Padding="4,12">

                                    <Label
                                        Text="{Binding NombreTaller}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="#1B475D" />

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="12">

                                        <VerticalStackLayout Spacing="4">
                                            <Label
                                                Text="Categoría"
                                                FontSize="12"
                                                TextColor="#1B475D" />

                                            <Label
                                                Text="{Binding Categoria}"
                                                FontSize="14"
                                                TextColor="#000000" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="4">

                                            <Label
                                                Text="Total de inscripciones"
                                                FontSize="12"
                                                TextColor="#1B475D" />

                                            <Label
                                                Text="{Binding TotalInscripciones}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="#1B475D" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <BoxView
                                        HeightRequest="1"
                                        Color="#D3DC7C" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>