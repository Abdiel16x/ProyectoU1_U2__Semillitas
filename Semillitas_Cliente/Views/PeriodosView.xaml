<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:Class="Semillitas_Cliente.Views.PeriodosView"
 Title="Períodos"
 BackgroundColor="#EEE5C2">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <VerticalStackLayout Spacing="5">
                <Label Text="Períodos"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#1B475D" />

                <Label Text="Consulta y administra los períodos de pago."
                   FontSize="14"
                   TextColor="Black" />
            </VerticalStackLayout>

            <Button Text="+ Nuevo período"
                Command="{Binding MostrarFormularioCommand}"
                BackgroundColor="#1B475D"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="48" />

            <Border IsVisible="{Binding FormularioVisible}"
                BackgroundColor="White"
                Stroke="#8EBD9D"
                StrokeThickness="1"
                Padding="16">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="Registrar período"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#1B475D" />

                    <Label Text="Nombre del período *"
                       FontAttributes="Bold"
                       TextColor="#1B475D" />

                    <Entry Placeholder="Ej. Octubre 2026"
                       Text="{Binding Nombre}"
                       BackgroundColor="#EEE5C2"
                       TextColor="#1B475D"
                       PlaceholderColor="#777777" />

                    <Label Text="Fecha de inicio *"
                       FontAttributes="Bold"
                       TextColor="#1B475D" />

                    <DatePicker Date="{Binding FechaInicio}"
                            Format="dd/MM/yyyy"
                            BackgroundColor="#EEE5C2"
                            TextColor="#1B475D" />

                    <Label Text="Fecha de fin *"
                       FontAttributes="Bold"
                       TextColor="#1B475D" />

                    <DatePicker Date="{Binding FechaFin}"
                            Format="dd/MM/yyyy"
                            BackgroundColor="#EEE5C2"
                            TextColor="#1B475D" />

                    <Label Text="Fecha de vencimiento *"
                       FontAttributes="Bold"
                       TextColor="#1B475D" />

                    <DatePicker Date="{Binding FechaVencimiento}"
                            Format="dd/MM/yyyy"
                            BackgroundColor="#EEE5C2"
                            TextColor="#1B475D" />

                    <Label Text="{Binding Mensaje}"
                       TextColor="#1B475D"
                       LineBreakMode="WordWrap" />

                    <Button Text="Guardar"
                        Command="{Binding GuardarCommand}"
                        BackgroundColor="#1B475D"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="45" />

                    <Button Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        BackgroundColor="#FAD564"
                        TextColor="#1B475D"
                        CornerRadius="10"
                        HeightRequest="45" />

                </VerticalStackLayout>
            </Border>

            <Entry Placeholder="Buscar período..."
               Text="{Binding Busqueda}"
               BackgroundColor="White"
               TextColor="#1B475D"
               PlaceholderColor="#777777"
               HeightRequest="48" />

            <Border BackgroundColor="White"
                Stroke="#8EBD9D"
                StrokeThickness="1"
                Padding="15">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label Text="Períodos registrados"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#1B475D" />

                    <CollectionView ItemsSource="{Binding Periodos}"
                                SelectionMode="None"
                                EmptyView="No hay períodos registrados.">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#EEE5C2"
                                    Stroke="#D3DC7C"
                                    StrokeThickness="1"
                                    Padding="12"
                                    Margin="0,0,0,10">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="8">

                                        <Label Text="{Binding Nombre}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="#1B475D" />

                                        <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto"
                                          ColumnSpacing="8"
                                          RowSpacing="6">

                                            <Label Text="Inicio:"
                                               FontAttributes="Bold"
                                               TextColor="#1B475D" />

                                            <Label Grid.Column="1"
                                               Text="{Binding FechaInicio, StringFormat='{0:dd/MM/yyyy}'}"
                                               TextColor="Black" />

                                            <Label Grid.Row="1"
                                               Text="Fin:"
                                               FontAttributes="Bold"
                                               TextColor="#1B475D" />

                                            <Label Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding FechaFin, StringFormat='{0:dd/MM/yyyy}'}"
                                               TextColor="Black" />

                                            <Label Grid.Row="2"
                                               Text="Vencimiento:"
                                               FontAttributes="Bold"
                                               TextColor="#1B475D" />

                                            <Label Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{Binding FechaVencimiento, StringFormat='{0:dd/MM/yyyy}'}"
                                               TextColor="Black" />

                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>