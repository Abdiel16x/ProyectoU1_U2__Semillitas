<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Semillitas_Cliente.Views.AgregarAlumnoView"
    Title="Agregar alumno"
    BackgroundColor="#EEE5C2">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="5">

                <Label
                    Text="Nuevo alumno"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#1B475D" />

                <Label
                    Text="Registra los datos del niño y su tutor responsable."
                    FontSize="14"
                    TextColor="#1B475D" />

            </VerticalStackLayout>

            <!-- Formulario -->
            <Border
                BackgroundColor="White"
                Stroke="#8EBD9D"
                StrokeShape="RoundRectangle 12"
                Padding="20">

                <VerticalStackLayout Spacing="16">

                    <!-- Nombre -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Nombre completo"
                            FontAttributes="Bold"
                            TextColor="#1B475D" />

                        <Entry
                            Placeholder="Nombre completo del niño"
                            Text="{Binding Nombre}"
                            TextColor="Black"
                            PlaceholderColor="#777777" />

                    </VerticalStackLayout>

                    <!-- Fecha de nacimiento -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Fecha de nacimiento"
                            FontAttributes="Bold"
                            TextColor="#1B475D" />

                        <DatePicker
                            Date="{Binding FechaNacimiento}"
                            Format="dd/MM/yyyy"
                            TextColor="Black" />

                    </VerticalStackLayout>

                    <!-- Tutor -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Tutor responsable"
                            FontAttributes="Bold"
                            TextColor="#1B475D" />

                        <Picker
                            Title="Seleccionar tutor"
                            ItemsSource="{Binding Tutores}"
                            ItemDisplayBinding="{Binding Nombre}"
                            SelectedItem="{Binding TutorSeleccionado}"
                            TextColor="Black"
                            TitleColor="#777777" />

                    </VerticalStackLayout>

                    <!-- Mensaje -->
                    <Label
                        Text="{Binding Mensaje}"
                        FontSize="13"
                        TextColor="#1B475D" />

                    <!-- Guardar -->
                    <Button
                        Text="Guardar alumno"
                        Command="{Binding GuardarCommand}"
                        BackgroundColor="#1B475D"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="48" />

                    <!-- Cancelar -->
                    <Button
                        Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        BackgroundColor="#FAD564"
                        TextColor="#1B475D"
                        CornerRadius="10"
                        HeightRequest="48" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>