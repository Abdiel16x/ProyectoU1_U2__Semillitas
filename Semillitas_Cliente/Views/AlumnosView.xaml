<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Semillitas_Cliente.Views.AlumnosView"
    Title="Alumnos"
    BackgroundColor="#EEE5C2">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="5">

                <Label
                    Text="Alumnos"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#1B475D" />

                <Label
                    Text="Consulta y administra los alumnos registrados en Semillitas."
                    FontSize="14"
                    TextColor="#1B475D" />

            </VerticalStackLayout>

            <!-- Agregar alumno -->
            <Button
                Text="+ Nuevo alumno"
                Command="{Binding AgregarAlumnoCommand}"
                BackgroundColor="#1B475D"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="48"
                HorizontalOptions="Fill" />

            <!-- Buscador y filtros -->
            <Border
                BackgroundColor="White"
                Stroke="#8EBD9D"
                StrokeShape="RoundRectangle 12"
                Padding="15">

                <VerticalStackLayout Spacing="12">

                    <Entry
                        Placeholder="Buscar alumno por nombre..."
                        Text="{Binding Busqueda}"
                        ClearButtonVisibility="WhileEditing"
                        BackgroundColor="White"
                        TextColor="Black"
                        PlaceholderColor="#777777"
                        HeightRequest="48" />

                    <Picker
                        Title="Filtrar por taller"
                        ItemsSource="{Binding Talleres}"
                        ItemDisplayBinding="{Binding Nombre}"
                        SelectedItem="{Binding TallerSeleccionado}"
                        BackgroundColor="White"
                        TextColor="Black"
                        TitleColor="#777777"
                        HeightRequest="48" />

                    <Picker
                        Title="Filtrar por estado"
                        ItemsSource="{Binding EstadosAlumno}"
                        SelectedItem="{Binding EstadoSeleccionado}"
                        BackgroundColor="White"
                        TextColor="Black"
                        TitleColor="#777777"
                        HeightRequest="48" />

                </VerticalStackLayout>
            </Border>

            <!-- Título de la lista -->
            <Label
                Text="Alumnos registrados"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#1B475D" />

            <!-- Lista de alumnos -->
            <CollectionView
                ItemsSource="{Binding Ninos}"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Border
                        BackgroundColor="White"
                        Stroke="#8EBD9D"
                        StrokeShape="RoundRectangle 12"
                        Padding="25">

                        <VerticalStackLayout
                            Spacing="8"
                            HorizontalOptions="Center">

                            <Label
                                Text="No hay alumnos registrados"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#1B475D"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Los alumnos registrados aparecerán aquí."
                                FontSize="13"
                                TextColor="#1B475D"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            BackgroundColor="White"
                            Stroke="#8EBD9D"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">

                            <VerticalStackLayout Spacing="12">

                                <!-- Nombre y estado -->
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="8">

                                    <Label
                                        Text="{Binding Nombre}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="#1B475D"
                                        VerticalOptions="Center" />

                                    <Border
                                        Grid.Column="1"
                                        BackgroundColor="#D3DC7C"
                                        Stroke="#D3DC7C"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8,4"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding Estado}"
                                            FontSize="12"
                                            TextColor="#1B475D"
                                            HorizontalTextAlignment="Center" />
                                    </Border>

                                </Grid>

                                <BoxView
                                    HeightRequest="1"
                                    Color="#8EBD9D" />

                                <!-- Edad -->
                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="Edad"
                                        FontSize="12"
                                        TextColor="#1B475D" />

                                    <Label
                                        Text="{Binding Edad}"
                                        FontSize="14"
                                        TextColor="Black" />

                                </VerticalStackLayout>

                                <!-- Talleres -->
                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="Talleres inscritos"
                                        FontSize="12"
                                        TextColor="#1B475D" />

                                    <Label
                                        Text="{Binding Talleres}"
                                        FontSize="14"
                                        TextColor="Black"
                                        LineBreakMode="WordWrap" />

                                </VerticalStackLayout>

                                <!-- Tutor -->
                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="Tutor responsable"
                                        FontSize="12"
                                        TextColor="#1B475D" />

                                    <Label
                                        Text="{Binding NombreTutor}"
                                        FontSize="14"
                                        TextColor="Black"
                                        LineBreakMode="WordWrap" />

                                </VerticalStackLayout>

                                <!-- Eliminar alumno -->
                                <Button
                                    Text="Eliminar alumno"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarAlumnoCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#1B475D"
                                    TextColor="White"
                                    CornerRadius="8"
                                    HeightRequest="44"
                                    Margin="0,4,0,0" />

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>